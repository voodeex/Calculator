<Window x:Class="Calculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор СМО" Height="660" Width="920"
        MinHeight="560" MinWidth="760"
        Background="#F3F5F9" FontSize="13"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E6EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2B3445"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#5B6577"/>
            <Setter Property="Margin" Value="0,6,0,3"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderBrush" Value="#CBD2DE"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="6,4"/>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Margin" Value="0,6,14,0"/>
        </Style>

        <Style x:Key="Btn" TargetType="Button">
            <Setter Property="Background" Value="#E8ECF3"/>
            <Setter Property="Foreground" Value="#2B3445"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BtnAccent" TargetType="Button" BasedOn="{StaticResource Btn}">
            <Setter Property="Background" Value="#3B6FE0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- ШАПКА -->
        <Border DockPanel.Dock="Top" Background="#2B3445" Padding="18,12">
            <StackPanel>
                <TextBlock Text="Калькулятор СМО" Foreground="White"
                           FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="системы массового обслуживания — расчёт характеристик"
                           Foreground="#AEB8CC" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Grid Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ЛЕВАЯ ПАНЕЛЬ: ВВОД -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Тип СМО" Style="{StaticResource Caption}"/>
                            <ComboBox x:Name="CmbType" SelectedIndex="0"
                                      SelectionChanged="CmbType_SelectionChanged">
                                <ComboBoxItem Content="1. Одноканальная с отказами" Tag="1"/>
                                <ComboBoxItem Content="2. Одноканальная с неогр. очередью" Tag="2"/>
                                <ComboBoxItem Content="3. Одноканальная с огр. очередью" Tag="3"/>
                                <ComboBoxItem Content="4. Многоканальная с отказами" Tag="4"/>
                                <ComboBoxItem Content="5. Многоканальная с неогр. очередью" Tag="5"/>
                                <ComboBoxItem Content="6. Многоканальная с огр. очередью" Tag="6"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Исходные данные" Style="{StaticResource Caption}"/>

                            <TextBlock Text="λ — интенсивность потока" Style="{StaticResource Label}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="120"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtLambda" Text="10"/>
                                <ComboBox x:Name="CmbLambdaUnit" Grid.Column="1"
                                          SelectedIndex="1" Margin="6,0,0,0">
                                    <ComboBoxItem Content="за минуту" Tag="min"/>
                                    <ComboBoxItem Content="за час" Tag="hour"/>
                                    <ComboBoxItem Content="за сутки" Tag="day"/>
                                </ComboBox>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <RadioButton x:Name="RbMu" Content="задать μ"
                                             IsChecked="True" Checked="RbMode_Checked"/>
                                <RadioButton x:Name="RbTime" Content="задать t_об"
                                             Checked="RbMode_Checked"/>
                            </StackPanel>

                            <StackPanel x:Name="PnlMu">
                                <TextBlock Text="μ — интенсивность обслуживания" Style="{StaticResource Label}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtMu" Text="12"/>
                                    <ComboBox x:Name="CmbMuUnit" Grid.Column="1"
                                              SelectedIndex="1" Margin="6,0,0,0">
                                        <ComboBoxItem Content="за минуту" Tag="min"/>
                                        <ComboBoxItem Content="за час" Tag="hour"/>
                                        <ComboBoxItem Content="за сутки" Tag="day"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="PnlTime" Visibility="Collapsed">
                                <TextBlock Text="t_об — время обслуживания" Style="{StaticResource Label}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtTime" Text="5"/>
                                    <ComboBox x:Name="CmbTimeUnit" Grid.Column="1"
                                              SelectedIndex="0" Margin="6,0,0,0">
                                        <ComboBoxItem Content="минут" Tag="min"/>
                                        <ComboBoxItem Content="часов" Tag="hour"/>
                                        <ComboBoxItem Content="суток" Tag="day"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="PnlN" Visibility="Collapsed">
                                <TextBlock Text="n — число каналов" Style="{StaticResource Label}"/>
                                <TextBox x:Name="TxtN" Text="2"/>
                            </StackPanel>

                            <StackPanel x:Name="PnlM" Visibility="Collapsed">
                                <TextBlock Text="m — макс. длина очереди" Style="{StaticResource Label}"/>
                                <TextBox x:Name="TxtM" Text="3"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Рассчитать" Click="BtnCalc_Click"
                                Style="{StaticResource BtnAccent}" Margin="0,0,4,0"/>
                        <Button Content="Очистить" Click="BtnClear_Click" Grid.Column="1"
                                Style="{StaticResource Btn}" Margin="4,0,0,0"/>
                    </Grid>

                    <Button Content="Экспорт в Excel" Click="BtnExport_Click"
                            Style="{StaticResource Btn}" Margin="0,8,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ПРАВАЯ ПАНЕЛЬ: РЕЗУЛЬТАТЫ -->
            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Результаты" Style="{StaticResource Caption}"/>
                    <TextBlock x:Name="TxtHeader" DockPanel.Dock="Top"
                               Text="расчёт не выполнен"
                               Foreground="#3B6FE0" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <TextBox x:Name="TxtOut"
                             IsReadOnly="True"
                             FontFamily="Consolas" FontSize="13"
                             Background="#F7F9FC" BorderBrush="#E2E6EE"
                             Padding="10" VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             AcceptsReturn="True"
                             Text="Выберите тип СМО, введите данные и нажмите «Рассчитать»."/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
