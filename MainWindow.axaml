<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Calculator.MainWindow"
        Title="Калькулятор СМО" Height="660" Width="920"
        MinHeight="560" MinWidth="760"
        Background="#F3F5F9" FontSize="13"
        WindowStartupLocation="CenterScreen">

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E6EE"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="14"/>
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#2B3445"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Foreground" Value="#5B6577"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style Selector="ComboBox">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="14,8"/>
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#3B6FE0"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#335FC4"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.accent:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A51A8"/>
        </Style>
    </Window.Styles>

    <DockPanel>
        <!-- ШАПКА -->
        <Border DockPanel.Dock="Top" Background="#2B3445" Padding="18,12">
            <StackPanel>
                <TextBlock Text="Калькулятор СМО" Foreground="White"
                           FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Text="системы массового обслуживания — расчёт характеристик"
                           Foreground="#AEB8CC" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <Grid Margin="14" ColumnDefinitions="330,*">

            <!-- ЛЕВАЯ ПАНЕЛЬ: ВВОД -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Classes="card">
                        <StackPanel>
                            <TextBlock Text="Тип СМО" Classes="caption"/>
                            <ComboBox x:Name="CmbType" SelectedIndex="0"
                                      SelectionChanged="CmbType_SelectionChanged">
                                <ComboBoxItem Content="1. Одноканальная с отказами" Tag="1"/>
                                <ComboBoxItem Content="2. Одноканальная с неогр. очередью" Tag="2"/>
                                <ComboBoxItem Content="3. Одноканальная с огр. очередью" Tag="3"/>
                                <ComboBoxItem Content="4. Многоканальная с отказами" Tag="4"/>
                                <ComboBoxItem Content="5. Многоканальная с неогр. очередью" Tag="5"/>
                                <ComboBoxItem Content="6. Многоканальная с огр. очередью" Tag="6"/>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Classes="card" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Исходные данные" Classes="caption"/>

                            <TextBlock Text="λ — интенсивность потока" Classes="label"/>
                            <Grid ColumnDefinitions="*,120">
                                <TextBox x:Name="TxtLambda" Text="10"/>
                                <ComboBox x:Name="CmbLambdaUnit" Grid.Column="1"
                                          SelectedIndex="1" Margin="6,0,0,0">
                                    <ComboBoxItem Content="за минуту" Tag="min"/>
                                    <ComboBoxItem Content="за час" Tag="hour"/>
                                    <ComboBoxItem Content="за сутки" Tag="day"/>
                                </ComboBox>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,8,0,0">
                                <RadioButton x:Name="RbMu" Content="задать μ" GroupName="mode"
                                             IsChecked="True" IsCheckedChanged="RbMode_Changed"/>
                                <RadioButton x:Name="RbTime" Content="задать t_об" GroupName="mode"
                                             IsCheckedChanged="RbMode_Changed"/>
                            </StackPanel>

                            <StackPanel x:Name="PnlMu">
                                <TextBlock Text="μ — интенсивность обслуживания" Classes="label"/>
                                <Grid ColumnDefinitions="*,120">
                                    <TextBox x:Name="TxtMu" Text="12"/>
                                    <ComboBox x:Name="CmbMuUnit" Grid.Column="1"
                                              SelectedIndex="1" Margin="6,0,0,0">
                                        <ComboBoxItem Content="за минуту" Tag="min"/>
                                        <ComboBoxItem Content="за час" Tag="hour"/>
                                        <ComboBoxItem Content="за сутки" Tag="day"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="PnlTime" IsVisible="False">
                                <TextBlock Text="t_об — время обслуживания" Classes="label"/>
                                <Grid ColumnDefinitions="*,120">
                                    <TextBox x:Name="TxtTime" Text="5"/>
                                    <ComboBox x:Name="CmbTimeUnit" Grid.Column="1"
                                              SelectedIndex="0" Margin="6,0,0,0">
                                        <ComboBoxItem Content="минут" Tag="min"/>
                                        <ComboBoxItem Content="часов" Tag="hour"/>
                                        <ComboBoxItem Content="суток" Tag="day"/>
                                    </ComboBox>
                                </Grid>
                            </StackPanel>

                            <StackPanel x:Name="PnlN" IsVisible="False">
                                <TextBlock Text="n — число каналов" Classes="label"/>
                                <TextBox x:Name="TxtN" Text="2"/>
                            </StackPanel>

                            <StackPanel x:Name="PnlM" IsVisible="False">
                                <TextBlock Text="m — макс. длина очереди" Classes="label"/>
                                <TextBox x:Name="TxtM" Text="3"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Grid ColumnDefinitions="*,*" Margin="0,12,0,0">
                        <Button Content="Рассчитать" Click="BtnCalc_Click"
                                Classes="accent" Margin="0,0,4,0"/>
                        <Button Content="Очистить" Click="BtnClear_Click"
                                Grid.Column="1" Margin="4,0,0,0"/>
                    </Grid>

                    <Button Content="Экспорт в Excel" Click="BtnExport_Click" Margin="0,8,0,0"/>

                    <TextBlock x:Name="TxtStatus" TextWrapping="Wrap" Margin="2,10,0,0"/>
                </StackPanel>
            </ScrollViewer>

            <!-- ПРАВАЯ ПАНЕЛЬ: РЕЗУЛЬТАТЫ -->
            <Border Grid.Column="1" Classes="card" Margin="14,0,0,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Результаты" Classes="caption"/>
                    <TextBlock x:Name="TxtHeader" DockPanel.Dock="Top"
                               Text="расчёт не выполнен"
                               Foreground="#3B6FE0" FontWeight="SemiBold" Margin="0,0,0,8"/>

                    <TextBox x:Name="TxtOut"
                             IsReadOnly="True" AcceptsReturn="True"
                             FontFamily="Consolas,Menlo,monospace" FontSize="13"
                             Background="#F7F9FC" BorderBrush="#E2E6EE"
                             Padding="10" VerticalContentAlignment="Top"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             Text="Выберите тип СМО, введите данные и нажмите «Рассчитать»."/>
                </DockPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
